# LLM providers
GROQ_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_MODEL=openai/gpt-oss-20b
MAX_SEARCH_RESULTS=7

# Memory (Redis + Postgres)
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://postgres:devpassword@localhost:5432/research_platform
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/research_platform
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CACHE_SIMILARITY_THRESHOLD=0.75
STM_TTL_SECONDS=3600
CACHE_TTL_SECONDS=86400

# Guardrails
USE_LLM_GUARDS=true
LLM_TIMEOUT=30

# Grading
SCORES_LOG=logs/scores.jsonl

# LangSmith (optional): records every judge score + runs evaluations
# Get a free key at smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=multi-agent-research

# Admin Backend Authentication
ADMIN_SECRET_KEY=change-this-in-production-to-a-secure-32-byte-hex-key
ADMIN_PROVISIONING_TOKEN=bootstrap-secret-change-me

# Regular User Authentication & Session Security
GOOGLE_CLIENT_ID=978274872957-do9v1dbnpc3dgmsq0sleu5olpn3d1enf.apps.googleusercontent.com
SESSION_COOKIE_NAME=user_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_DAYS=30
REQUIRE_LOGIN=false
AUTH_STORAGE_BACKEND=postgres
NEUTRALIZE_DEMO_USERS=true
TRUSTED_PROXY=false
ALLOWED_AUTH_HOSTS=localhost:8000,127.0.0.1:8000
